#ifndef CHIBILLM_KERNEL_COMMON
#define CHIBILLM_KERNEL_COMMON

#include <metal_stdlib>

using namespace metal;

#if __METAL_VERSION__ >= 310
using bf16_storage = bfloat;
using bf16x4_storage = bfloat4;

static inline float
load_bf16(bf16_storage value)
{
    return float(value);
}

static inline float4
load_bf16x4(bf16x4_storage value)
{
    return float4(value);
}
#else
using bf16_storage = ushort;
using bf16x4_storage = ushort4;

static inline float
load_bf16(bf16_storage value)
{
    return as_type<float>(uint(value) << 16);
}

static inline float4
load_bf16x4(bf16x4_storage value)
{
    return as_type<float4>(uint4(value) << 16);
}
#endif

static inline float
linear_bf16_decode_dot(device const float* input,
                       device const bf16_storage* weight,
                       uint input_features,
                       uint weight_row,
                       uint lane,
                       uint simd_width)
{
    float accumulator = 0.0F;
    const ulong weight_base = ulong(weight_row) * ulong(input_features);
    for (uint k = lane * 4; k + 3 < input_features; k += 4 * simd_width) {
        const float4 input_values = { input[k], input[k + 1], input[k + 2], input[k + 3] };
        const bf16x4_storage packed_values = { weight[weight_base + ulong(k)],
                                               weight[weight_base + ulong(k + 1)],
                                               weight[weight_base + ulong(k + 2)],
                                               weight[weight_base + ulong(k + 3)] };
        const float4 weight_values = load_bf16x4(packed_values);
        accumulator += dot(input_values, weight_values);
    }
    const uint vectorized_features = input_features & ~3u;
    for (uint k = vectorized_features + lane; k < input_features; k += simd_width) {
        const float value = load_bf16(weight[weight_base + ulong(k)]);
        accumulator += input[k] * value;
    }
    return simd_sum(accumulator);
}

struct bf16_matrix {
    device const bf16_storage* values;
    uint columns;

    float
    load(ulong row, uint column) const
    {
        return load_bf16(values[row * columns + column]);
    }

    float
    dot(device const float* input, uint row, uint lane, uint simd_width) const
    {
        return linear_bf16_decode_dot(input, values, columns, row, lane, simd_width);
    }
};

// Pipeline specialization fixes the bit width before execution.
constant uint affine_bits [[function_constant(0)]];

struct affine_matrix {
    device const uint* values;
    device const bf16_storage* scales;
    device const bf16_storage* offsets;
    uint columns;

    float
    load(ulong row, uint column) const
    {
        const ulong index = row * columns + column;
        const uint values_per_word = 32 / affine_bits;
        const uint packed = values[index / values_per_word];
        const float q = float((packed >> ((column % values_per_word) * affine_bits))
                              & ((1u << affine_bits) - 1u));
        return load_bf16(scales[index / 64]) * q + load_bf16(offsets[index / 64]);
    }

    float
    dot(device const float* input, uint row, uint lane, uint simd_width) const
    {
        float accumulator = 0.0f;
        const ulong base = ulong(row) * columns;
        const uint values_per_word = 32 / affine_bits;
        for (uint k = lane * values_per_word; k < columns; k += simd_width * values_per_word) {
            uint packed = values[(base + k) / values_per_word];
            float product = 0.0f;
            float sum = 0.0f;
            for (uint i = 0; i < values_per_word; ++i) {
                const float x = input[k + i];
                product += x * float(packed & ((1u << affine_bits) - 1u));
                sum += x;
                packed >>= affine_bits;
            }
            accumulator += load_bf16(scales[(base + k) / 64]) * product
                + load_bf16(offsets[(base + k) / 64]) * sum;
        }
        return simd_sum(accumulator);
    }
};

static inline bf16_storage
store_bf16(float value)
{
#if __METAL_VERSION__ >= 310
    return bfloat(value);
#else
    uint bits = as_type<uint>(value);
    bits += 0x7fffu + ((bits >> 16) & 1u);
    return ushort(bits >> 16);
#endif
}

#endif
